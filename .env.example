OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required to enable AI requests. Enter this passphrase in the app's AI panel.
APP_ACCESS_TOKEN=
# Azure Files (server only; never use NEXT_PUBLIC_ for these settings)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_FILE_SHARE=cleanexpense
# PostgreSQL primary storage (server only). Azure remains available for migration/backup.
DATABASE_URL=
# Base64-encoded PEM CA certificate from the Aiven service's connection page.
DATABASE_CA_CERT_BASE64=
